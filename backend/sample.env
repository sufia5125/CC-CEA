# Copy to .env for local development. Never commit .env.
PORT=8800
DB_HOST=localhost
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=artwall
DB_SSL=false
JWT_SECRET_KEY=
STRIPE_SECRET_KEY=
CORS_ORIGIN=http://localhost:5173
FRONTEND_URL=http://localhost:5173

# Admin account created by `npm run db:admin` (admins cannot self-register)
ADMIN_NAME=admin
ADMIN_EMAIL=admin@artwall.com
ADMIN_PASSWORD=
